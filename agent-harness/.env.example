# ─── LLM Configuration ───────────────────────────────────────────────
# Set these to connect to your LLM provider.

# Required: Your API key
API_KEY=your-api-key-here

# Required: API endpoint URL
# For OpenAI: https://api.openai.com/v1
# For Azure OpenAI: https://your-resource.openai.azure.com
# For local models (Ollama): http://localhost:11434
API_ENDPOINT=https://api.openai.com/v1

# Optional: Model to use
API_MODEL=gpt-5.6-luna

# Optional: Provider type — openai (default), anthropic, or azure
API_PROVIDER=openai

# ─── Server Configuration ────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Optional: writable folder for uploaded bills.
# The Docker default is /tmp/uploads.
UPLOAD_DIR=/tmp/uploads

# Optional: host path for knowledge docs mounted into Docker.
# Use this if your local repo path contains a colon or other character Docker
# cannot parse in volume mounts.
# KNOWLEDGE_DOCS_HOST_PATH=/private/tmp/pba-knowledge-docs-copy
